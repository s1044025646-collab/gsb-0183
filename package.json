{
  "name": "cv-kalman-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "离线二维单目标常速度卡尔曼跟踪后端（TypeScript + Node.js + SQLite）",
  "bin": {
    "tracker": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server/index.ts",
    "dev": "tsx src/server/index.ts",
    "cli": "tsx src/cli/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "demo": "tsx src/demo/run.ts",
    "seed": "tsx src/cli/index.ts seed --force"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
